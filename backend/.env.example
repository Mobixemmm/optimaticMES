DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=gateway
DATABASE_PASSWORD=changeme
DATABASE_NAME=machine_data
PORT=3001
NODE_ENV=development

# Auth — generate a real secret, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=8h
# Set to true when serving the API over HTTPS in production
COOKIE_SECURE=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Symulacja odczytów z czujnika temperatury — TYLKO dev/demo, nigdy na produkcji
SENSOR_SIMULATION=false

# Strefa czasowa używana do liczenia zmian/dni w analityce OEE
TZ=Europe/Warsaw

# Szyfrowanie haseł i kluczy API systemów zewnętrznych (moduł Integracje).
# 32 bajty zapisane szesnastkowo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Pominięcie tej zmiennej NIE blokuje startu — klucz zostanie wyprowadzony
# z JWT_SECRET przez HKDF. Skutek uboczny: rotacja JWT_SECRET unieważni
# wszystkie zapisane hasła do ERP i trzeba je wpisać ponownie.
INTEGRATION_ENCRYPTION_KEY=
