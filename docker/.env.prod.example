# Skopiuj do docker/.env.prod i uzupełnij prawdziwymi wartościami.
# docker/.env.prod jest w .gitignore — nigdy nie commituj prawdziwych sekretów.

# Hasło do bazy TimescaleDB (użytkownik "gateway")
DB_PASSWORD=changeme

# Generuj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret

# Domena/adres, z którego przeglądarka operatora ładuje frontend (bez trailing slash)
CORS_ORIGINS=https://mes.przyklad-fabryka.local

# Publiczny adres backendu widoczny z przeglądarki — wypiekany do frontendu przy budowie
VITE_API_URL=https://mes-api.przyklad-fabryka.local

TZ=Europe/Warsaw
